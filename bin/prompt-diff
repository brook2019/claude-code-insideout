#!/usr/bin/env bash
set -euo pipefail

# System Prompt Diff Tool
# Usage: ./bin/prompt-diff extract <session.jsonl> [-o prompt.md]
#        ./bin/prompt-diff diff <file1> <file2> [-o diff.html]
#        ./bin/prompt-diff compare <s1.jsonl> <s2.jsonl> [-o diff.html]

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

exec bun run ./src/tools/systemPromptDiff.ts "$@"
